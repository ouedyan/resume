{
  "name": "resume",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.17.0 <25",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "rm -rf .next/types .next/dev/types && next typegen && tsc --noEmit",
    "check": "pnpm test && pnpm lint && pnpm typecheck && pnpm build && pnpm audit --prod --audit-level moderate"
  },
  "dependencies": {
    "@sparticuz/chromium": "149.0.0",
    "next": "16.2.9",
    "puppeteer-core": "25.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.18",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18"
    }
  }
}
